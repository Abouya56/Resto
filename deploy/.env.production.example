# Copiez ce fichier en « .env » à la racine du projet sur le serveur, puis remplacez chaque valeur « CHANGEZ ».
# Ne mettez JAMAIS ce fichier rempli sur GitHub.

# L'adresse du site, sans https:// (ex. monresto.duckdns.org)
DOMAIN=CHANGEZ.duckdns.org

# Clé secrète : une longue suite de caractères au hasard (voir le guide pour en générer une).
DJANGO_SECRET_KEY=CHANGEZ-par-une-cle-tres-longue-et-secrete
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ALLOWED_HOSTS=CHANGEZ.duckdns.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://CHANGEZ.duckdns.org
CSRF_TRUSTED_ORIGINS=https://CHANGEZ.duckdns.org
CORS_ALLOWED_ORIGINS=https://CHANGEZ.duckdns.org
SITE_URL=https://CHANGEZ.duckdns.org

# Base de données (le mot de passe est à vous : choisissez-en un long)
POSTGRES_DB=resto
POSTGRES_USER=resto
POSTGRES_PASSWORD=CHANGEZ-mot-de-passe-de-la-base
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Mises à jour en direct des écrans
REDIS_URL=redis://redis:6379/0

# Pas d'envoi d'e-mails pour l'instant
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@CHANGEZ.duckdns.org

DEMO_LOGINS=False
USE_SQLITE=False
USE_INMEMORY_CHANNELS=False
STOCK_ENABLED=false
