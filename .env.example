# Django
DJANGO_SECRET_KEY=changez-moi-par-une-cle-secrete-longue
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production uniquement : origines HTTPS autorisées pour les formulaires (ex. https://resto.example.com)
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SETTINGS_MODULE=config.settings.development

# Base de données PostgreSQL
POSTGRES_DB=resto
POSTGRES_USER=resto
POSTGRES_PASSWORD=changez-moi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (Channels / WebSockets)
REDIS_URL=redis://localhost:6379/0

# Email (développement : console)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@resto.local

# Paiement (placeholders — aucun prestataire réel)
PAYMENT_PROVIDER=simulated
PAYMENT_WEBHOOK_SECRET=

# Comptes de démonstration sur la page de connexion (activés par défaut en développement, jamais en production)
DEMO_LOGINS=True

# Site
SITE_URL=http://127.0.0.1:8000

# True uniquement pour un démarrage local sans PostgreSQL
USE_SQLITE=False
USE_INMEMORY_CHANNELS=True
